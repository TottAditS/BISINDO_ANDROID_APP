<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#88000000"
            android:padding="6dp"
            android:text="@string/guide_box_hint"
            android:textColor="#FFEB3B"
            android:textSize="14sp" />

        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@drawable/guide_box" />

    </LinearLayout>

    <com.example.bisindorecognizer.overlay.HandOverlayView
        android:id="@+id/handOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnCloseCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:backgroundTint="#AA000000"
        android:text="@string/btn_close_camera"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnTargetClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:backgroundTint="#AA000000"
        android:textColor="#FFFFFF"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:backgroundTint="#AAD32F2F"
        android:text="@string/btn_record"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/predictionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:padding="16dp"
        android:text="@string/prediction_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center" />

</FrameLayout>
